--!nonstrict
-- Home (screens/7 "Home · meetings") from a mocked host state.
local fx = require("./fixtures")

local function home(app, meetings)
	-- The details first: the host answers them before it lists a meeting.
	app:set_state("mock_details", fx.home_details())
	app:set_state("meetings", meetings or fx.home_meetings())
	app:set_state("window.home", true)
	app:frames(2)
	return app:window("home")
end

test("Home opens when the host says so", function()
	local app = mount()
	expect(app:window("home")).to_be_nil()
	expect(home(app)).never.to_be_nil()
end)

test("meetings are grouped by day, newest first", function()
	local win = home(mount())
	expect(win:text("#day-1")).to_be("Today")
	expect(win:text("#day-2")).to_be("Yesterday")
	expect(string.match(win:text("#day-3"), "^%a%a%a, %a%a%a %d+$")).never.to_be_nil()
	expect(win:has("#day-4")).to_be(false)
end)

test("a meeting row has its title and duration", function()
	local win = home(mount())
	expect(win:text("#meeting-launch-title")).to_be("Mobile app launch on Dec 1")
	expect(win:text("#meeting-launch-duration")).to_be("2:00")
	expect(win:text("#meeting-sync-duration")).to_be("32:10")
	expect(win:text("#meeting-review-duration")).to_be("1:02:03")
end)

test("a meeting that never finished offers Recover", function()
	local win = home(mount())
	expect(string.match(win:text("#meeting-crashed-title"), "^Unfinished meeting, %d+:%d%d [AP]M$")).never.to_be_nil()
	expect(win:text("#meeting-crashed-duration")).to_be("Recover")
end)

test("the newest meeting is selected and its detail shows", function()
	local win = home(mount())
	expect(win:text("#detail-title")).to_be("Mobile app launch on Dec 1")
	expect(win:text("#detail-overview")).to_be(fx.OVERVIEW)
	expect(string.match(win:text("#detail-date"), "^%a%a%a, %a%a%a %d+, %d+:%d%d [AP]M$")).never.to_be_nil()
	expect(win:text("#detail-duration")).to_be("2:00")
	expect(win:text("#speaker-1")).to_be("Tom")
	expect(win:text("#speaker-2")).to_be("Priya")
	expect(win:text("#speaker-3")).to_be("David")
end)

test("clicking a meeting selects it", function()
	local app = mount()
	local win = home(app)
	win:click("#meeting-sync")
	expect(app:state("home_selected")).to_be("sync")
	expect(win:wait("#detail-title", { text = "Weekly design sync" })).to_be(true)
	expect(win:has("#speaker-1")).to_be(false)
	expect(#app:state("calls")).to_be(0)
end)

test("the arrows move the selection", function()
	local app = mount()
	local win = home(app)
	win:key("ArrowDown")
	expect(app:state("home_selected")).to_be("sync")
	win:key("ArrowDown")
	win:key("ArrowDown")
	win:key("ArrowDown")
	win:key("ArrowDown")
	expect(app:state("home_selected")).to_be("review")
	win:key("ArrowUp")
	expect(app:state("home_selected")).to_be("crashed")
end)

test("Enter opens the selected meeting in the Notes window", function()
	local app = mount()
	local win = home(app)
	win:key("Enter")
	expect(app:state("calls")).to_equal({ { name = "open_meeting", arg = "launch" } })
end)

test("a double click opens a meeting", function()
	local app = mount()
	local win = home(app)
	win:double_click("#meeting-sync")
	local calls = app:state("calls")
	expect(calls[#calls]).to_equal({ name = "open_meeting", arg = "sync" })
end)

test("the footer opens the selected meeting", function()
	local app = mount()
	local win = home(app)
	expect(win:text("#open-meeting")).to_be("Open Meeting")
	win:click("#open-meeting")
	expect(app:state("calls")).to_equal({ { name = "open_meeting", arg = "launch" } })
end)

test("Start new notes asks the host to start", function()
	local app = mount()
	local win = home(app)
	expect(win:text("#start-notes")).to_be("Start new notes")
	win:click("#start-notes")
	expect(app:state("calls")).to_equal({ { name = "start_notes", arg = nil } })
end)

test("typing narrows the list to matching titles", function()
	local app = mount()
	local win = home(app)
	win:type("#home-search", "design")
	expect(win:wait("#meeting-launch", { gone = true })).to_be(true)
	expect(win:has("#meeting-sync")).to_be(true)
	expect(app:state("home_selected")).to_be("sync")
end)

test("with no meetings there is only Start new notes", function()
	local app = mount()
	local win = home(app, {})
	expect(win:has("#start-notes")).to_be(true)
	expect(win:has("#day-1")).to_be(false)
	expect(win:has("#detail-title")).to_be(false)
	expect(win:has("#open-meeting")).to_be(false)
	win:key("Enter")
	expect(#app:state("calls")).to_be(0)
end)

test("a stored meeting reads in the Notes window with speaker names", function()
	local app = mount()
	app:set_state("mock_rows", fx.named_rows())
	app:set_state("meeting", { state = "stopped", elapsed_ms = 120000, title = "Mobile app launch on Dec 1", started_ms = fx.STARTED_MS, id = "launch" })
	app:set_state("transcript", { count = 3, open = {} })
	app:set_state("window.notes", true)
	app:frames(2)
	local win = app:window("notes")
	expect(win:text("#meeting-title")).to_be("Mobile app launch on Dec 1")
	expect(win:text("#row-1")).to_be("Tom")
	expect(win:text("#row-2")).to_be("Priya")
	expect(win:text("#row-3")).to_be("David")
	expect(win:has("#stop")).to_be(false)
	-- Read from the top, nothing live to jump to.
	app:set_state("transcript_at_end", false)
	app:frames(2)
	expect(win:has("#jump-to-live")).to_be(false)
end)
