--!nonstrict
-- Settings (screens/8, 8b–8e) from a mocked host: the sidebar, the
-- Providers page, the Add provider list and forms.
local pfx = require("./provider_fixtures")

local function calls(app)
	return app:state("calls")
end

local function last_call(app)
	local c = calls(app)
	return c[#c]
end

test("Settings opens with its pages in the sidebar", function()
	local app = mount()
	expect(app:window("settings")).to_be_nil()
	local win = pfx.settings(app)
	for _, label in { "General", "Captions", "Audio", "Providers", "Glossary", "Shortcuts", "Storage" } do
		expect(win:has(`"{label}"`)).to_be(true)
	end
	expect(win:text("#settings-title")).to_be("Settings")
end)

test("a page is chosen from the sidebar", function()
	local app = mount()
	local win = pfx.settings(app)
	expect(win:has("#providers-page")).to_be(true)
	win:click("#nav-general")
	expect(app:state("settings_page")).to_be("general")
	expect(win:wait("#providers-page", { gone = true })).to_be(true)
	win:click("#nav-providers")
	expect(win:wait("#providers-page")).to_be(true)
end)

test("searching the sidebar narrows its pages", function()
	local app = mount()
	local win = pfx.settings(app)
	win:type("#settings-search", "prov")
	expect(win:wait("#nav-general", { gone = true })).to_be(true)
	expect(win:has("#nav-providers")).to_be(true)
end)

test("each job shows its main and backup", function()
	local win = pfx.settings(mount())
	expect(win:text("#job-live-label")).to_be("Live captions")
	expect(win:text("#job-live-main-name")).to_be("ElevenLabs")
	expect(win:text("#job-live-backup-name")).to_be("Deepgram")
	expect(win:text("#job-transcript-main-name")).to_be("ElevenLabs")
	expect(win:text("#job-summary-main-name")).to_be("Claude Code")
	expect(win:text("#job-summary-backup-name")).to_be("OpenRouter")
end)

-- Seen in the real app: each picker was 68 px wide, its name cut to "…".
test("each picker fills its column, its name in full", function()
	local win = pfx.settings(mount())
	local function width(sel)
		local line = string.split(win:tree(sel), "\n")[1]
		return tonumber(string.match(line, "(%d+)x%d+$"))
	end
	expect(width("#job-live-main") > 150).to_be(true)
	expect(width("#job-live-backup")).to_be(width("#job-live-main"))
	expect(width("#job-live-main-name") > 60).to_be(true)
end)

test("the live captions picker hides providers that can't caption live", function()
	local win = pfx.settings(mount())
	win:click("#job-live-main")
	expect(win:wait("#pick-live-main-deepgram")).to_be(true)
	expect(win:has("#pick-live-main-elevenlabs")).to_be(true)
	expect(win:has("#pick-live-main-whisper")).to_be(false)
	expect(win:has("#pick-live-main-claude_code")).to_be(false)
end)

test("the transcript picker hides an engine without speakers", function()
	local win = pfx.settings(mount())
	win:click("#job-transcript-backup")
	expect(win:wait("#pick-transcript-backup-elevenlabs")).to_be(true)
	expect(win:has("#pick-transcript-backup-whisper")).to_be(false)
	-- A backup may be none.
	expect(win:has("#pick-transcript-backup-none")).to_be(true)
end)

test("the summary picker lists only AI providers", function()
	local win = pfx.settings(mount())
	win:click("#job-summary-main")
	expect(win:wait("#pick-summary-main-ollama")).to_be(true)
	expect(win:has("#pick-summary-main-openrouter")).to_be(true)
	expect(win:has("#pick-summary-main-elevenlabs")).to_be(false)
	-- The main can't be none.
	expect(win:has("#pick-summary-main-none")).to_be(false)
end)

test("choosing a provider asks the host", function()
	local app = mount()
	local win = pfx.settings(app)
	win:click("#job-live-main")
	win:wait("#pick-live-main-deepgram")
	win:click("#pick-live-main-deepgram")
	expect(last_call(app)).to_equal({ name = "set_job", arg = { job = "live", slot = "main", provider = "deepgram" } })
	win:click("#job-live-backup")
	win:wait("#pick-live-backup-none")
	win:click("#pick-live-backup-none")
	expect(last_call(app).arg.slot).to_be("backup")
	expect(last_call(app).arg.provider).to_be_nil()
end)

test("speech engines show what they can do and their masked key", function()
	local win = pfx.settings(mount())
	expect(win:text("#stt-elevenlabs-name")).to_be("ElevenLabs")
	expect(win:text("#stt-elevenlabs-ability-1")).to_be("Live")
	expect(win:text("#stt-elevenlabs-ability-2")).to_be("Speakers")
	expect(win:text("#stt-elevenlabs-ability-3")).to_be("Keyterms")
	expect(win:text("#stt-elevenlabs-key")).to_be("sk_••••3f9a")
	expect(win:text("#stt-deepgram-key")).to_be("••••a21c")
	expect(win:text("#stt-elevenlabs-change")).to_be("Change")
	-- Whisper: no Live, no Speakers; no key yet.
	expect(win:has("#stt-whisper-ability-1")).to_be(false)
	expect(win:text("#stt-whisper-change")).to_be("Add key")
end)

test("AI providers show their model or command and where they run", function()
