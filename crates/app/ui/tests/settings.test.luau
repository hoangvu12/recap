test("Ctrl N opens Add provider", function()
	local app = mount()
	local win = pfx.settings(app)
	win:key("ctrl+n")
	expect(app:state("provider_sheet").screen).to_be("pick")
end)

test("typing narrows the presets, Enter continues with the first", function()
	local app = mount()
	local win = pfx.settings(app)
	win:click("#add-provider")
	win:wait("#provider-search")
	win:type("#provider-search", "router")
	expect(win:wait("#preset-anthropic", { gone = true })).to_be(true)
	expect(win:has("#preset-openrouter")).to_be(true)
	win:key("Enter")
	expect(app:state("provider_sheet")).to_equal({ screen = "form", preset = "openrouter", id = "" })
end)

test("the arrows move through the presets", function()
	local app = mount()
	local win = pfx.settings(app)
	win:click("#add-provider")
	win:wait("#provider-search")
	win:key("ArrowDown")
	win:key("ArrowDown")
	expect(app:state("provider_selected")).to_be("openrouter")
	win:key("Enter")
	expect(app:state("provider_sheet").preset).to_be("openrouter")
end)

local function openrouter_form(app)
	local win = pfx.settings(app)
	win:click("#add-provider")
	win:wait("#preset-openrouter")
	win:click("#preset-openrouter")
	win:click("#continue")
	expect(win:wait("#form-title", { text = "OpenRouter" })).to_be(true)
	return win
end

test("an API preset's form asks for a key, a model and a base URL", function()
	local app = mount()
	local win = openrouter_form(app)
	expect(win:has("#form-key")).to_be(true)
	expect(win:text("#form-model")).to_be("deepseek/deepseek-chat-v3")
	expect(win:text("#form-base-url")).to_be("https://openrouter.ai/api/v1")
	expect(win:has("#form-command")).to_be(false)
	expect(win:text("#form-save")).to_be("Add Provider")
end)

test("Test sends the form as typed and shows the time it took", function()
	local app = mount()
	local win = openrouter_form(app)
	win:type("#form-key", "sk-or-v1-abc")
	win:click("#form-test")
	local call = last_call(app)
	expect(call.name).to_be("test_provider")
	expect(call.arg.target).to_be("new:openrouter")
	expect(call.arg.draft.key).to_be("sk-or-v1-abc")
	expect(call.arg.draft.preset).to_be("openrouter")
	app:set_state("provider_test", { target = "new:openrouter", status = "ok", latency_ms = 1400, error = "" })
	expect(win:wait("#form-test-result", { text = "1.4 s" })).to_be(true)
	expect(win:has("#form-test-ok")).to_be(true)
end)

test("a failed Test shows the error", function()
	local app = mount()
	local win = openrouter_form(app)
	app:set_state("provider_test", { target = "new:openrouter", status = "error", latency_ms = 300, error = "Key refused" })
	expect(win:wait("#form-test-result", { text = "Key refused" })).to_be(true)
	-- Another form's Test doesn't show here.
	app:set_state("provider_test", { target = "ollama", status = "ok", latency_ms = 300, error = "" })
	expect(win:wait("#form-test-result", { gone = true })).to_be(true)
end)

test("Add Provider saves the form and closes it", function()
	local app = mount()
	local win = openrouter_form(app)
	win:type("#form-key", "sk-or-v1-abc")
	win:click("#form-save")
	local call = last_call(app)
	expect(call.name).to_be("save_provider")
	expect(call.arg.preset).to_be("openrouter")
	expect(call.arg.key).to_be("sk-or-v1-abc")
	expect(call.arg.model).to_be("deepseek/deepseek-chat-v3")
	expect(app:state("provider_sheet").screen).to_be("closed")
end)

test("a custom command takes a name, a command with tokens and how the transcript goes in", function()
	local app = mount()
	local win = pfx.settings(app)
	win:click("#add-provider")
	win:wait("#provider-search")
	win:type("#provider-search", "command")
	expect(win:wait("#preset-anthropic", { gone = true })).to_be(true)
	win:double_click("#preset-custom_command")
	expect(win:wait("#form-title", { text = "Custom command" })).to_be(true)
	expect(win:has("#form-key")).to_be(false)
	win:type("#form-name", "Gemini CLI")
	win:type("#form-command", "gemini -p ")
	win:click("#token-prompt")
	expect(win:text("#form-command")).to_be("gemini -p {prompt}")
	win:click('#form-input >> "file"')
	expect(app:state("form_input")).to_be("file")
	win:key("ctrl+Enter")
	local call = last_call(app)
	expect(call.name).to_be("save_provider")
	expect(call.arg.name).to_be("Gemini CLI")
	expect(call.arg.command).to_be("gemini -p {prompt}")
	expect(call.arg.input).to_be("file")
	expect(call.arg.key).to_be_nil()
end)

test("a saved provider opens in its form and can be removed", function()
	local app = mount()
	local win = pfx.settings(app)
	win:click("#ai-openrouter")
	expect(win:wait("#form-title", { text = "OpenRouter" })).to_be(true)
	expect(win:text("#form-model")).to_be("deepseek-chat-v3")
	expect(win:text("#form-save")).to_be("Save")
	win:click("#form-remove")
	expect(last_call(app)).to_equal({ name = "remove_provider", arg = "openrouter" })
end)

test("Change on a speech engine asks for its key only", function()
	local app = mount()
	local win = pfx.settings(app)
	win:click("#stt-elevenlabs-change")
	expect(win:wait("#form-title", { text = "ElevenLabs" })).to_be(true)
	expect(win:has("#form-model")).to_be(false)
	expect(win:has("#form-remove")).to_be(false)
	win:type("#form-key", "sk_new")
	win:click("#form-save")
	local call = last_call(app)
	expect(call.arg.preset).to_be("elevenlabs")
	expect(call.arg.id).to_be("elevenlabs")
	expect(call.arg.key).to_be("sk_new")
end)

test("the back arrow returns from a form to the list, and from the list closes", function()
	local app = mount()
	local win = openrouter_form(app)
	win:click("#sheet-back")
	expect(app:state("provider_sheet").screen).to_be("pick")
	win:click("#sheet-back")
	expect(app:state("provider_sheet").screen).to_be("closed")
end)

test("Ctrl , in Home opens Settings", function()
	local app = mount()
	app:set_state("window.home", true)
	app:frames(2)
	app:window("home"):key("ctrl+,")
	app:frames(2)
	expect(app:window("settings")).never.to_be_nil()
end)
